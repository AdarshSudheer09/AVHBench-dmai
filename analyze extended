# ============================================================
# ANALYSIS 4: Residual-trajectory - override test
# ============================================================
print("\n" + "="*60)
print("ANALYSIS 4: Residual trajectory - override test")
print("="*60)
print("Loading lm_head + token embeddings from safetensors...")
with open(INDEX_FILE) as f:
    index = json.load(f)
weight_map = index['weight_map']

def load_param(name):
    shard = weight_map[name]
    with safe_open(f"{MODEL_PATH}/{shard}", framework="pt", device=0) as f:
        return f.get_tensor(name)

EMBED_W = load_param('model.embed_tokens.weight').to(device).to(torch.bfloat16)  # [vocab, hidden]
print(f"  embed_tokens: {EMBED_W.shape}")

print("Processing residual captures for trajectory analysis...")

files = sorted(glob.glob(f"{CAPTURE_RES_DIR}/*.pt"))
traj_rows = []
t0 = time.time()
BATCH = 256

for batch_start in range(0, len(files), BATCH):
    batch_files = files[batch_start:batch_start + BATCH]
    last_toks = []
    pred_token_ids = []
    metas = []
    for f in batch_files:
        d = torch.load(f, map_location='cpu', weights_only=False)
        last_toks.append(d['residuals_by_position']['last_tok'])
        pred_token_ids.append(d['snap_target_token'])
        metas.append({
            'capture': os.path.basename(f).replace('.pt',''),
            'config': d['config'],
            'is_yn_question': d['is_yn_question'],
        })
    last_tok_b = torch.stack(last_toks).to(device).to(torch.bfloat16)  # [B, L, H]
    B, L, H = last_tok_b.shape

    h18 = last_tok_b[:, 18, :]  # [B, H]
    pred_idx = torch.tensor(pred_token_ids, device=device, dtype=torch.long)
    pred_emb = EMBED_W[pred_idx]  # [B, H]

    @torch.no_grad()
    def cosine_with_ref(residuals, ref):
        r = residuals.float()
        f = ref.float()
        rn = r / (r.norm(dim=-1, keepdim=True) + 1e-8)
        fn = f / (f.norm(dim=-1, keepdim=True) + 1e-8)
        return (rn * fn.unsqueeze(1)).sum(-1).cpu().numpy()  # [B, L]

    cos_to_h18  = cosine_with_ref(last_tok_b, h18)
    cos_to_pred = cosine_with_ref(last_tok_b, pred_emb)

    for i, m in enumerate(metas):
        for lay in range(L):
            traj_rows.append({
                **m, 'layer': lay,
                'cos_to_h18':  float(cos_to_h18[i, lay]),
                'cos_to_pred': float(cos_to_pred[i, lay]),
            })

    del last_tok_b
    torch.cuda.empty_cache()
    if (batch_start + B) % 1024 == 0:
        elapsed = time.time() - t0
        print(f"  [{batch_start+B}/{len(files)}] {elapsed:.1f}s")

traj_df = pd.DataFrame(traj_rows)
traj_df.to_parquet(f"{OUT_DIR}/residual_trajectory.parquet")
print(f"Trajectory table: {len(traj_df)} rows")

fig, axes = plt.subplots(1, 2, figsize=(13, 4.5), sharex=True)
for ax, (col, title) in zip(axes, [
    ('cos_to_h18',  'cosine(h_l, h_18)  - similarity to post-conflict-heads state'),
    ('cos_to_pred', 'cosine(h_l, embed[pred]) - similarity to predicted-token embedding'),
]):
    for cfg in CONFIG_ORDER:
        sub = traj_df[(traj_df.config == cfg) & traj_df.is_yn_question]
        if len(sub) == 0: continue
        agg = sub.groupby('layer')[col].agg(['mean', 'std', 'count']).reset_index()
        ax.plot(agg.layer, agg['mean'], color=CONFIG_COLORS[cfg], lw=2,
                label=f"{cfg} (n={agg['count'].iloc[0]})")
        ax.fill_between(agg.layer, agg['mean']-agg['std'], agg['mean']+agg['std'],
                        color=CONFIG_COLORS[cfg], alpha=0.15)
    ax.set_xlabel('layer'); ax.set_ylabel('cosine')
    ax.set_title(title); ax.set_xlim(0, 27); ax.grid(True, alpha=0.3); ax.legend(fontsize=8, frameon=False)
    ax.axvline(18, color='gray', lw=0.7, ls='--', alpha=0.5)
fig.suptitle('Residual trajectory at answer position - override test\n'
             'If prior overrides: left plot drops after layer 18, right plot rises sharply after layer 22', y=1.0)
plt.tight_layout(); savefig(fig, "extended_4_residual_trajectory")

print("\nCrossover layer (cos_to_pred > cos_to_h18) per config:")
for cfg in CONFIG_ORDER:
    sub = traj_df[(traj_df.config == cfg) & traj_df.is_yn_question]
    if len(sub) == 0: continue
    agg = sub.groupby('layer')[['cos_to_h18','cos_to_pred']].mean()
    cross = agg[(agg.cos_to_pred > agg.cos_to_h18)].index
    cross_layer = int(cross.min()) if len(cross) else -1
    print(f"  {cfg}: crossover at layer {cross_layer}")

print(f"\n=== ALL DONE. Outputs: {OUT_DIR} ===")
