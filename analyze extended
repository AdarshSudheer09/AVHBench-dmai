# ANALYSIS 1: Entropy on the 21 audit heads (case-study captures)
# ============================================================
print("\n" + "="*60)
print("ANALYSIS 1: Entropy on the 21 audit heads (case study)")
print("="*60)

with open(HEAD_MAP) as f:
    hm = json.load(f)
HEADS = [f"L{h['layer']}.H{h['head']}" for h in hm['conflict_resolution_heads']]
print(f"21 audit heads: {HEADS}")

attn_files = sorted(glob.glob(f"{CAPTURE_ATTN_DIR}/*.pt"))
print(f"Found {len(attn_files)} attention captures (case-study)")

def entropy_full(attn):
    """Mean per-row entropy over the saved attention rows.
    attn shape: [n_query_rows, n_keys] fp16, rows are softmaxed already"""
    p = attn.float().numpy()
    p = np.clip(p, 1e-12, 1.0)
    return float(-(p * np.log(p)).sum(axis=1).mean())

ent_rows = []
for f in attn_files:
    d = torch.load(f, map_location='cpu', weights_only=False)
    cfg = d['config']
    is_matching = 'matching' in d['question'].lower()
    for hk in HEADS:
        if hk not in d['head_attention']: continue
        ent = entropy_full(d['head_attention'][hk])
        ent_rows.append({
            'config': cfg, 'video_id': d['video_id'],
            'question_hash': d['question_hash'], 'head': hk,
            'is_matching': is_matching, 'entropy': ent,
        })
ent_df = pd.DataFrame(ent_rows)

print("\nMean entropy per config (21 heads, all questions):")
for cfg in ['acca', 'tati']:
    sub = ent_df[ent_df.config == cfg]
    if len(sub) == 0: continue
    print(f"  {cfg}: mean={sub.entropy.mean():.3f}  std={sub.entropy.std():.3f}  n={len(sub)}")

print("\nMean entropy per config x question type:")
for cfg in ['acca', 'tati']:
    for q_type, mask in [('matching', ent_df.is_matching), ('single-modality', ~ent_df.is_matching)]:
        sub = ent_df[(ent_df.config == cfg) & mask]
        if len(sub) == 0: continue
        print(f"  {cfg:5s} x {q_type:15s}: mean={sub.entropy.mean():.3f} std={sub.entropy.std():.3f} n={len(sub)}")

acca_mean = ent_df[ent_df.config == 'acca'].entropy.mean()
tati_mean = ent_df[ent_df.config == 'tati'].entropy.mean()
print(f"\nDelta TATI - ACCA: {tati_mean - acca_mean:+.3f}")
print(f"Paper Table 2 claim: delta = -2.72 (3.84 -> 1.12)")
print(f"Our finding:        delta = {tati_mean - acca_mean:+.2f} ({acca_mean:.2f} -> {tati_mean:.2f})")

# Figure: entropy by head, ACCA vs TATI
fig, ax = plt.subplots(figsize=(13, 5))
heads_sorted = sorted(HEADS, key=lambda h: (int(h.split('.')[0][1:]), int(h.split('.')[1][1:])))
x = np.arange(len(heads_sorted))
acca_per_head = [ent_df[(ent_df.config == 'acca') & (ent_df.head == h)].entropy.mean() for h in heads_sorted]
tati_per_head = [ent_df[(ent_df.config == 'tati') & (ent_df.head == h)].entropy.mean() for h in heads_sorted]
ax.bar(x - 0.2, acca_per_head, 0.4, color=CONFIG_COLORS['acca'], label='ACCA')
ax.bar(x + 0.2, tati_per_head, 0.4, color=CONFIG_COLORS['tati'], label='TATI')
ax.set_xticks(x); ax.set_xticklabels(heads_sorted, rotation=45, ha='right')
ax.set_ylabel('Mean attention entropy (nats)')
ax.set_title(f'Entropy per audit head (n={len(attn_files)} case-study captures)\n'
             f'Paper Table 2: ACCA 3.84 -> TATI 1.12 (delta -2.72) | '
             f'Our: ACCA {acca_mean:.2f} -> TATI {tati_mean:.2f} (delta {tati_mean-acca_mean:+.2f})')
ax.legend(); ax.grid(True, alpha=0.3)
plt.tight_layout(); savefig(fig, "extended_1_entropy_per_head")

ent_df.to_csv(f"{OUT_DIR}/entropy_per_head.csv", index=False)
print(f"Entropy table saved.")


