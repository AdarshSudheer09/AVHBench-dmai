"""
Logit lens + AV survival analysis on residual stream captures.

For each capture:
  - Compute per-layer probability of the snap-target token at the answer position
  - Find the "snap layer" — earliest layer where snap-target becomes argmax (top-1)
  - Compute per-layer cosine similarity between answer-position residual and AV-mean
  - Aggregate everything into a wide table for plotting

Outputs:
  /workspace/acca_work/analysis_output/per_capture.parquet  (or .csv)
  /workspace/acca_work/analysis_output/per_layer.parquet
  Three figures (F: trajectory, G: snap histogram, H: AV survival)
"""
import os, glob, json, time
import torch
import torch.nn.functional as F
import numpy as np
import pandas as pd
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
from transformers import AutoTokenizer
from videollama2.model.videollama2_qwen2 import Videollama2Qwen2ForCausalLM
from transformers import AutoConfig
from transformers.modeling_utils import PreTrainedModel

# --- config ---
CAPTURE_DIR = "/workspace/acca_work/residual_output"
OUT_DIR     = "/workspace/acca_work/analysis_output"
MODEL_PATH  = "/workspace/VideoLLaMA2-7B-AV"
os.makedirs(OUT_DIR, exist_ok=True)
os.makedirs(f"{OUT_DIR}/png", exist_ok=True)
os.makedirs(f"{OUT_DIR}/pdf", exist_ok=True)

CONFIG_COLORS = {
    'baseline': '#7f7f7f',  # gray (reference)
    'acca':     '#1f77b4',  # blue
    'tati':     '#ff7f0e',  # orange
    'full':     '#d62728',  # red
}
CONFIG_ORDER = ['baseline', 'acca', 'tati', 'full']

# --- load lm_head + final layer norm from the base model ---
# We only need lm_head and the final norm to project residuals → vocab.
print("Loading lm_head + final norm from base model (CPU, takes ~10s)...")
def use_eager(cls, config, *args, **kwargs):
    config._attn_implementation = "eager"; return config
PreTrainedModel._check_and_enable_flash_attn_2 = classmethod(use_eager)

cfg = AutoConfig.from_pretrained(MODEL_PATH)
cfg._attn_implementation = "eager"
base = Videollama2Qwen2ForCausalLM.from_pretrained(
    MODEL_PATH, config=cfg, torch_dtype=torch.float32,
    low_cpu_mem_usage=False
)
LM_HEAD = base.lm_head.cpu().float()           # (vocab, hidden)
NORM    = base.get_model().norm.cpu().float()  # final RMSNorm
del base
import gc; gc.collect()
print(f"  lm_head: {LM_HEAD.weight.shape}")

tokenizer = AutoTokenizer.from_pretrained(MODEL_PATH)
print("Tokenizer loaded.")

# --- helpers ---
@torch.no_grad()
def logit_lens_probs(residual_per_layer, target_token_id):
    """
    residual_per_layer: tensor [n_layers, hidden] (fp16 on CPU)
    target_token_id: int

    Returns:
      probs[L]:  probability of target token at each layer (numpy array)
      argmax[L]: argmax token id at each layer
    """
    r = residual_per_layer.float()  # [L, H]
    # apply final RMSNorm (Qwen2 uses RMSNorm; treat layers consistently)
    r_normed = NORM(r)              # [L, H]
    logits = r_normed @ LM_HEAD.weight.T  # [L, vocab]
    probs_full = F.softmax(logits, dim=-1)
    target_probs = probs_full[:, target_token_id].numpy()
    argmaxes = logits.argmax(dim=-1).numpy()
    return target_probs, argmaxes

def find_snap_layer(argmaxes, target_id):
    """earliest layer where argmax == target. -1 if never matches."""
    matches = np.where(argmaxes == target_id)[0]
    return int(matches[0]) if len(matches) else -1

@torch.no_grad()
def cosine_to_av_mean(residual_per_layer, av_mean):
    """
    residual_per_layer: [n_layers, hidden] fp16
    av_mean: [hidden] fp16
    Returns: [n_layers] cosine similarity per layer
    """
    r = residual_per_layer.float()  # [L, H]
    a = av_mean.float()             # [H]
    a_norm = a / (a.norm() + 1e-8)
    r_norms = r / (r.norm(dim=-1, keepdim=True) + 1e-8)
    return (r_norms @ a_norm).numpy()  # [L]

# --- main loop ---
files = sorted(glob.glob(f"{CAPTURE_DIR}/*.pt"))
print(f"\nProcessing {len(files)} capture files...")

per_capture_rows = []
per_layer_rows = []
t0 = time.time()

for i, f in enumerate(files):
    d = torch.load(f, map_location="cpu", weights_only=False)
    base_id = os.path.basename(f).replace('.pt', '')
    vid = d['video_id']
    qhash = d['question_hash']
    config = d['config']
    snap_tgt = d['snap_target_token']
    is_yn = d['is_yn_question']
    is_correct = d['is_correct']
    audio_ok = d['audio_ok']

    # We use the LAST_TOK position (the position whose next-prediction is the answer)
    last_tok_residual = d['residuals_by_position']['last_tok']  # [n_layers, hidden]
    last_av_residual  = d['residuals_by_position']['last_av']
    av_mean = d['av_mean_input']

    # 1) Logit lens at last_tok position, target = snap_target_token
    target_probs, argmaxes = logit_lens_probs(last_tok_residual, snap_tgt)
    snap_layer = find_snap_layer(argmaxes, snap_tgt)

    # Also track Yes / No / A probabilities for any capture (lets us compare
    # which prior wins layer-by-layer regardless of what was actually predicted)
    yes_probs, _ = logit_lens_probs(last_tok_residual, d['YES_TOK'])
    no_probs,  _ = logit_lens_probs(last_tok_residual, d['NO_TOK'])
    a_probs,   _ = logit_lens_probs(last_tok_residual, d['A_TOK'])

    # 2) AV survival at last_tok and last_av
    cos_last_tok = cosine_to_av_mean(last_tok_residual, av_mean)
    cos_last_av  = cosine_to_av_mean(last_av_residual,  av_mean)

    n_layers = last_tok_residual.shape[0]

    per_capture_rows.append({
        'capture': base_id, 'video_id': vid, 'question_hash': qhash,
        'config': config, 'is_yn_question': is_yn, 'is_correct': is_correct,
        'audio_ok': audio_ok,
        'ground_truth': d['ground_truth'],
        'prediction': d['prediction'][:60],
        'snap_target_token': snap_tgt,
        'snap_layer': snap_layer,
        'final_target_prob': float(target_probs[-1]),
        'final_yes_prob':    float(yes_probs[-1]),
        'final_no_prob':     float(no_probs[-1]),
        'final_a_prob':      float(a_probs[-1]),
        'cos_last_tok_layer0':     float(cos_last_tok[0]),
        'cos_last_tok_final':      float(cos_last_tok[-1]),
        'cos_last_av_layer0':      float(cos_last_av[0]),
        'cos_last_av_final':       float(cos_last_av[-1]),
    })

    for L in range(n_layers):
        per_layer_rows.append({
            'capture': base_id, 'video_id': vid, 'question_hash': qhash,
            'config': config, 'layer': L,
            'is_yn_question': is_yn,
            'target_prob': float(target_probs[L]),
            'yes_prob':    float(yes_probs[L]),
            'no_prob':     float(no_probs[L]),
            'a_prob':      float(a_probs[L]),
            'cos_to_av_lasttok': float(cos_last_tok[L]),
            'cos_to_av_lastav':  float(cos_last_av[L]),
        })

    if (i+1) % 100 == 0:
        elapsed = time.time() - t0
        rate = (i+1) / elapsed
        print(f"  [{i+1}/{len(files)}] {rate:.1f}/s, ETA {(len(files)-i-1)/rate:.0f}s")

print(f"\nDone in {time.time()-t0:.1f}s.")

# --- save tables ---
pc = pd.DataFrame(per_capture_rows)
pl = pd.DataFrame(per_layer_rows)
pc.to_parquet(f"{OUT_DIR}/per_capture.parquet")
pl.to_parquet(f"{OUT_DIR}/per_layer.parquet")
pc.to_csv(f"{OUT_DIR}/per_capture.csv", index=False)
print(f"Saved tables to {OUT_DIR}/")
print(f"  per_capture: {len(pc)} rows")
print(f"  per_layer:   {len(pl)} rows")

# --- quick summary printout ---
print("\n=== Summary by config ===")
for cfg in CONFIG_ORDER:
    sub = pc[pc.config == cfg]
    if len(sub) == 0: continue
    yn_sub = sub[sub.is_yn_question]
    cap_sub = sub[~sub.is_yn_question]
    snap_yn = yn_sub.snap_layer[yn_sub.snap_layer >= 0]
    print(f"  {cfg:10s}: {len(sub)} captures  ({len(yn_sub)} yn, {len(cap_sub)} cap)  "
          f"acc={sub.is_correct.mean():.1%}  "
          f"yn_snap_layer mean={snap_yn.mean():.1f}±{snap_yn.std():.1f}")

# --- Figure F: logit lens trajectory (mean across captures, per config) ---
print("\nFigure F: logit lens trajectory")
fig, axes = plt.subplots(1, 3, figsize=(15, 4.5), sharex=True)

for ax, (col, title) in zip(axes, [
    ('target_prob', 'P(snap target token)'),
    ('yes_prob',    'P(" Yes")'),
    ('no_prob',     'P(" No")'),
]):
    for cfg in CONFIG_ORDER:
        sub = pl[(pl.config == cfg) & (pl.is_yn_question)]
        if len(sub) == 0: continue
        agg = sub.groupby('layer')[col].agg(['mean', 'std', 'count']).reset_index()
        ax.plot(agg.layer, agg['mean'], color=CONFIG_COLORS[cfg], lw=2, label=f"{cfg} (n={agg['count'].iloc[0]})")
        ax.fill_between(agg.layer, agg['mean'] - agg['std'], agg['mean'] + agg['std'],
                        color=CONFIG_COLORS[cfg], alpha=0.15)
    ax.set_xlabel('layer'); ax.set_ylabel('probability')
    ax.set_title(title); ax.set_xlim(0, 27)
    ax.grid(True, alpha=0.3); ax.legend(fontsize=8, frameon=False)

fig.suptitle('Figure F: Logit lens trajectory at answer position (Yes/No questions, mean ± std)', y=1.02)
plt.tight_layout()
fig.savefig(f"{OUT_DIR}/png/figure_F_logit_lens.png", dpi=300, bbox_inches='tight')
fig.savefig(f"{OUT_DIR}/pdf/figure_F_logit_lens.pdf", bbox_inches='tight')
plt.close(fig)

# --- Figure G: snap layer distribution ---
print("Figure G: snap layer histograms")
fig, ax = plt.subplots(1, 1, figsize=(9, 4.5))
yn_pc = pc[pc.is_yn_question & (pc.snap_layer >= 0)]
for cfg in CONFIG_ORDER:
    sub = yn_pc[yn_pc.config == cfg]
    if len(sub) == 0: continue
    ax.hist(sub.snap_layer, bins=range(0, 29), alpha=0.4,
            color=CONFIG_COLORS[cfg], label=f"{cfg} (n={len(sub)}, μ={sub.snap_layer.mean():.1f})",
            edgecolor=CONFIG_COLORS[cfg], lw=1.5)
ax.set_xlabel('snap layer (earliest where prediction commits)')
ax.set_ylabel('count')
ax.set_title('Figure G: Snap layer distribution by config (Yes/No questions)')
ax.set_xlim(-0.5, 28.5); ax.set_xticks(range(0, 28, 2))
ax.grid(True, alpha=0.3); ax.legend(frameon=False)
fig.savefig(f"{OUT_DIR}/png/figure_G_snap_histogram.png", dpi=300, bbox_inches='tight')
fig.savefig(f"{OUT_DIR}/pdf/figure_G_snap_histogram.pdf", bbox_inches='tight')
plt.close(fig)

# --- Figure H: AV survival ---
print("Figure H: AV survival curves")
fig, axes = plt.subplots(1, 2, figsize=(13, 4.5), sharey=True)
for ax, (col, title) in zip(axes, [
    ('cos_to_av_lasttok', 'cosine(last_tok residual, AV-mean)'),
    ('cos_to_av_lastav',  'cosine(last_AV residual,  AV-mean)'),
]):
    for cfg in CONFIG_ORDER:
        sub = pl[(pl.config == cfg) & (pl.is_yn_question)]
        if len(sub) == 0: continue
        agg = sub.groupby('layer')[col].agg(['mean', 'std', 'count']).reset_index()
        ax.plot(agg.layer, agg['mean'], color=CONFIG_COLORS[cfg], lw=2, label=f"{cfg} (n={agg['count'].iloc[0]})")
        ax.fill_between(agg.layer, agg['mean'] - agg['std'], agg['mean'] + agg['std'],
                        color=CONFIG_COLORS[cfg], alpha=0.15)
    ax.set_xlabel('layer'); ax.set_title(title)
    ax.set_xlim(0, 27); ax.grid(True, alpha=0.3); ax.legend(fontsize=8, frameon=False)
axes[0].set_ylabel('cosine similarity')
fig.suptitle('Figure H: AV-content survival in residual stream (mean ± std across YN captures)', y=1.02)
plt.tight_layout()
fig.savefig(f"{OUT_DIR}/png/figure_H_av_survival.png", dpi=300, bbox_inches='tight')
fig.savefig(f"{OUT_DIR}/pdf/figure_H_av_survival.pdf", bbox_inches='tight')
plt.close(fig)

print(f"\nDONE. See {OUT_DIR}/png/ and {OUT_DIR}/pdf/")
print("Figures: figure_F_logit_lens, figure_G_snap_histogram, figure_H_av_survival")
PYEOF

